# Playback worker: the same source tree as the API, plus ffmpeg.
#
# A separate image because ffmpeg and its codecs roughly double the size, and
# the API has no use for them.

FROM python:3.14.6-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# No libpq: asyncpg speaks the Postgres wire protocol itself, so nothing here
# links against it. libffi is for argon2-cffi.
RUN apt-get update && apt-get install -y \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

FROM python:3.14.6-slim AS production

LABEL org.opencontainers.image.title="streamchen-worker"
LABEL org.opencontainers.image.description="streamchen playback worker (yt-dlp -> ffmpeg -> Icecast)"
LABEL org.opencontainers.image.url="https://github.com/crazynudelsieb/streamchen"
LABEL org.opencontainers.image.source="https://github.com/crazynudelsieb/streamchen"
LABEL org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0"

# XDG_CACHE_HOME is where yt-dlp keeps YouTube's player javascript once it has
# fetched and interpreted it. Given nowhere to write it does that again for
# every single track, which is seconds of silence per song: the container user
# has no home directory, so the default (~/.cache) cannot be created and the
# cache silently never hits. Deliberately not the audio cache -- that one is a
# tmpfs the worker purges at startup and sweeps to a budget, and this has to
# survive both.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    AUDIO_CACHE_DIR=/var/cache/streamchen \
    XDG_CACHE_HOME=/var/cache/streamchen-extractor

RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Fixed uid/gid: compose mounts the audio cache as a tmpfs over
# /var/cache/streamchen, and a tmpfs comes up owned by root regardless of what
# the image did. The mount has to name an owner, so that owner has to be stable.
RUN groupadd -r -g 10001 streamchen && useradd -r -u 10001 -g streamchen streamchen

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY app ./app

# The first is a tmpfs in compose, so a restart cannot inherit media from the
# run before it. The second must not be: see XDG_CACHE_HOME above.
RUN mkdir -p /var/cache/streamchen /var/cache/streamchen-extractor && \
    chown -R streamchen:streamchen \
        /app /var/cache/streamchen /var/cache/streamchen-extractor

USER streamchen

CMD ["python", "-m", "app.worker"]
