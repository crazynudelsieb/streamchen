# Playback worker: the same source tree as the API, plus ffmpeg.
#
# A separate image because ffmpeg and its codecs roughly double the size, and
# the API has no use for them.

FROM python:3.14.6-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

FROM python:3.14.6-slim AS production

LABEL org.opencontainers.image.title="streamchen-worker"
LABEL org.opencontainers.image.description="streamchen playback worker (yt-dlp -> ffmpeg -> Icecast)"
LABEL org.opencontainers.image.url="https://github.com/crazynudelsieb/streamchen"
LABEL org.opencontainers.image.source="https://github.com/crazynudelsieb/streamchen"
LABEL org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    AUDIO_CACHE_DIR=/var/cache/streamchen

RUN apt-get update && apt-get install -y \
    libpq5 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN groupadd -r streamchen && useradd -r -g streamchen streamchen

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY app ./app

# tmpfs in compose, so a restart cannot inherit media from the run before it.
RUN mkdir -p /var/cache/streamchen && \
    chown -R streamchen:streamchen /app /var/cache/streamchen

USER streamchen

CMD ["python", "-m", "app.worker"]
