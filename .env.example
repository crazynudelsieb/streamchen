# streamchen configuration
#
# Copy to .env and fill in. Only the values under "Required" have no sensible
# default; everything else can be left alone.

# =============================================================================
# Required
# =============================================================================

# Public hostname, used by Traefik routing and announced by Icecast.
PUBLIC_HOST=streamchen.example.com

# Absolute public URL of the app. Room share links are built from it.
BASE_URL=https://streamchen.example.com

# Where the browser fetches the audio stream. Traefik routes /stream to
# Icecast, so this is BASE_URL + /stream -- the room's mount is appended
# automatically.
ICECAST_PUBLIC_URL=https://streamchen.example.com/stream

# Database. The only persistent storage in the system.
POSTGRES_DB=streamchen
POSTGRES_USER=streamchen
POSTGRES_PASSWORD=change-me

# Icecast credentials. The source password is shared with the playback worker;
# the admin password only guards Icecast's own status pages.
#   openssl rand -base64 24
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me

# =============================================================================
# Application
# =============================================================================

APP_NAME=streamchen
LOG_LEVEL=INFO
TZ=Europe/Vienna

# Send cookies only over HTTPS. Leave true anywhere real.
SECURE_COOKIES=true

# Reverse proxies in front of the app, used to pick a non-spoofable client IP.
# 1 = Traefik only, which is what docker-compose.yml sets up.
TRUSTED_PROXY_COUNT=1

# Cross-origin API access. Empty (the default) means same-origin only, which is
# what the bundled deployment uses. Comma-separated when you need it.
CORS_ORIGINS=

# =============================================================================
# Rooms
# =============================================================================

# Defaults for a newly created room; a host can change them per room.
MAX_LISTENERS=100
MAX_PENDING_PER_LISTENER=3

# Longest track accepted, in seconds. Keeps one person from parking a
# ten-hour upload at the front of the queue.
MAX_TRACK_DURATION_S=900

# Rooms nobody has touched for this many days are deleted.
ROOM_IDLE_DAYS=7

# =============================================================================
# Spam protection (concept §10)
# =============================================================================

# "1 request / 15 seconds" for adding a song.
ADD_RATE_LIMIT=1
ADD_RATE_WINDOW_S=15

# "5 requests / 10 seconds" for voting.
VOTE_RATE_LIMIT=5
VOTE_RATE_WINDOW_S=10

# "4 searches / 10 seconds", and how many hits one search returns. Searching
# changes nothing but costs an upstream extraction per result, so it is capped
# tighter than it looks like it needs to be.
SEARCH_RATE_LIMIT=4
SEARCH_RATE_WINDOW_S=10
SEARCH_RESULTS=8

# "6 renames / 60 seconds". Changing your name costs nothing upstream, but it
# invalidates the room for everyone in it, so it is capped anyway.
RENAME_RATE_LIMIT=6
RENAME_RATE_WINDOW_S=60

# Refused requests in a row before a listener is silently shadow-banned, and
# for how long.
SHADOW_BAN_STRIKES=5
SHADOW_BAN_MINUTES=15

# =============================================================================
# Playback
# =============================================================================

ICECAST_BITRATE_KBPS=128
ICECAST_MAX_CLIENTS=500
ICECAST_MAX_SOURCES=50

# Bytes Icecast hands a listener the moment they connect. A browser needs a few
# frames decoded before it will play anything and the stream itself only carries
# 16 KB a second, so this is what decides how quickly play() starts. It is also
# how far behind live a listener begins, so raising it is not free: 65536 is
# four seconds at 128 kbps.
ICECAST_BURST_SIZE=65536

# Temporary audio cache: current track plus the next one, nothing else.
# The tmpfs is sized a little above the budget so the hard limit is the app's.
AUDIO_CACHE_BUDGET_BYTES=1073741824
AUDIO_CACHE_TMPFS_SIZE=1200m

# How long a prefetched track may sit unplayed before it is swept.
AUDIO_PREFETCH_TTL_S=600

# =============================================================================
# SEO (off by default)
# =============================================================================

SEO_ENABLED=false
SEO_SITE_NAME=streamchen

# =============================================================================
# Contact / social — footer icons. Only what you fill in is shown.
# =============================================================================

# Rendered obfuscated: no literal address ever appears in the page source.
CONTACT_EMAIL=
# Full profile URL (rel="me" lets Mastodon verify it back).
CONTACT_MASTODON=
# Username or full URL.
CONTACT_GITHUB=
CONTACT_KOFI=
CONTACT_BUYMEACOFFEE=

# =============================================================================
# Legal / Impressum — the /imprint page appears once IMPRINT_NAME is set.
# Use \n inside address / extra to force line breaks.
# =============================================================================

IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
IMPRINT_PHONE=
IMPRINT_VAT=
IMPRINT_EXTRA=

# Optional data-residency note shown on /privacy. Blank hides the line.
DATA_LOCATION=
