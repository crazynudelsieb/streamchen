# streamchen configuration
#
# Copy to .env and fill in. Only the values under "Required" have no sensible
# default; everything else can be left alone.

# =============================================================================
# Required
# =============================================================================

# Public hostname, used by Traefik routing and announced by Icecast.
PUBLIC_HOST=streamchen.example.com

# Absolute public URL of the app. Room share links are built from it.
BASE_URL=https://streamchen.example.com

# Where the browser fetches the audio stream. Traefik routes /stream to
# Icecast, so this is BASE_URL + /stream -- the room's mount is appended
# automatically.
ICECAST_PUBLIC_URL=https://streamchen.example.com/stream

# Database. The only persistent storage in the system.
POSTGRES_DB=streamchen
POSTGRES_USER=streamchen
POSTGRES_PASSWORD=change-me

# Icecast credentials. The source password is shared with the playback worker;
# the admin password only guards Icecast's own status pages.
#   openssl rand -base64 24
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me

# =============================================================================
# Application
# =============================================================================

APP_NAME=streamchen
LOG_LEVEL=INFO
TZ=Europe/Vienna

# Send cookies only over HTTPS. Leave true anywhere real.
SECURE_COOKIES=true

# Reverse proxies in front of the app, used to pick a non-spoofable client IP.
# 1 = Traefik only, which is what docker-compose.yml sets up.
TRUSTED_PROXY_COUNT=1

# Cross-origin API access. Empty (the default) means same-origin only, which is
# what the bundled deployment uses. Comma-separated when you need it.
CORS_ORIGINS=

# =============================================================================
# Rooms
# =============================================================================

# Defaults for a newly created room; a host can change them per room.
MAX_LISTENERS=100
MAX_PENDING_PER_LISTENER=3

# Longest track accepted, in seconds. Keeps one person from parking a
# ten-hour upload at the front of the queue.
MAX_TRACK_DURATION_S=900

# Rooms nobody has touched for this many days are deleted.
ROOM_IDLE_DAYS=7

# =============================================================================
# Hourly news (off in every room until its host turns it on)
# =============================================================================

# Podcast feed the bulletins come from. One feed for the instance: a host
# chooses *whether* their room plays news, never where the server fetches from.
# The default is ORF Ö1 Journale — Austrian, and its "Frühjournal um 6" and
# "Journal um 5" editions are the short ones, about nine or ten minutes each.
# Any podcast feed works; ORF's follow
#   https://podcast.orf.at/podcast/<station>/<show>/<show>.xml
# Blank switches the feature off everywhere, including the host panel.
NEWS_FEED_URL=https://podcast.orf.at/podcast/oe1/oe1_journale/oe1_journale.xml

# What the player calls it while a bulletin is on air.
NEWS_SOURCE_LABEL=ORF Ö1 Journale

# Default cadence for a room that turns news on; the host can change it
# (15-720 minutes). The feed's newest short edition is what plays, so if the
# station has not published since the last one, the same bulletin is heard
# again -- which is what "the news" is on any radio through an afternoon.
NEWS_INTERVAL_MIN=60

# Longest edition that counts as a bulletin. This is what picks the short
# editions out of a feed that also carries hour-long programmes -- an episode
# that does not say how long it is never plays.
NEWS_MAX_DURATION_S=660

# And how old the newest edition may be and still be news at all. Past this,
# nothing plays until the station publishes again.
NEWS_MAX_AGE_H=24

# How long one fetched feed is reused for every room on the instance.
NEWS_FEED_TTL_S=600

# Hard cap on one downloaded clip.
NEWS_MAX_BYTES=33554432

# =============================================================================
# Spam protection (concept §10)
# =============================================================================

# "1 request / 15 seconds" for adding a song.
ADD_RATE_LIMIT=1
ADD_RATE_WINDOW_S=15

# "5 requests / 10 seconds" for voting.
VOTE_RATE_LIMIT=5
VOTE_RATE_WINDOW_S=10

# "4 searches / 10 seconds", and how many hits one search shows. A search is
# two upstream requests however many results come back -- the listing carries
# titles, durations and channels, so nothing has to be looked up per hit.
SEARCH_RATE_LIMIT=4
SEARCH_RATE_WINDOW_S=10
SEARCH_RESULTS=8

# "6 renames / 60 seconds". Changing your name costs nothing upstream, but it
# invalidates the room for everyone in it, so it is capped anyway.
RENAME_RATE_LIMIT=6
RENAME_RATE_WINDOW_S=60

# "6 messages / 10 seconds" in the room chat. Chat costs nothing upstream and
# nothing in the database, so this is here to stop a flood filling everyone's
# screen rather than to ration talking.
CHAT_RATE_LIMIT=6
CHAT_RATE_WINDOW_S=10

# Refused requests in a row before a listener is silently shadow-banned, and
# for how long.
SHADOW_BAN_STRIKES=5
SHADOW_BAN_MINUTES=15

# =============================================================================
# Playback
# =============================================================================

ICECAST_BITRATE_KBPS=128
ICECAST_MAX_CLIENTS=500
ICECAST_MAX_SOURCES=50

# Bytes Icecast hands a listener the moment they connect. A browser needs a few
# frames decoded before it will play anything and the stream itself only carries
# 16 KB a second, so this is what decides how quickly play() starts. It is also
# how far behind live a listener begins, so raising it is not free: 65536 is
# four seconds at 128 kbps.
ICECAST_BURST_SIZE=65536

# Temporary audio cache: current track plus the next one, nothing else.
# The tmpfs is sized a little above the budget so the hard limit is the app's.
AUDIO_CACHE_BUDGET_BYTES=1073741824
AUDIO_CACHE_TMPFS_SIZE=1200m

# How long a prefetched track may sit unplayed before it is swept.
AUDIO_PREFETCH_TTL_S=600

# Loudness levelling. Tracks arrive at whatever level they were uploaded at, so
# each one is measured while the previous is still playing and corrected to a
# fixed target — otherwise a listener reaches for the volume at every handover.
# Turning this off costs nothing and levels nothing.
AUDIO_NORMALIZE=true

# The target, in LUFS. -14 is roughly what YouTube normalises to itself, so the
# correction on a typical track is small.
AUDIO_TARGET_LUFS=-14
# True-peak ceiling in dBTP, under the -1 broadcast convention because what
# leaves here is a 128 kbit MP3 and lossy encoding overshoots.
AUDIO_TARGET_TP=-1.5
# Loudness range. Below this a track is corrected by one fixed gain; above it,
# loudnorm compresses the range instead and the track changes character. The
# broadcast convention of 11 is under what ordinary music measures, so this is
# deliberately loose.
AUDIO_TARGET_LRA=20
# Cap on the analysis pass, which decodes the whole file as fast as it can.
# Only here to catch the one that never finishes.
AUDIO_MEASURE_TIMEOUT_S=120

# =============================================================================
# SEO (off by default)
# =============================================================================

SEO_ENABLED=false
SEO_SITE_NAME=streamchen

# =============================================================================
# Contact / social — footer icons. Only what you fill in is shown.
# =============================================================================

# Rendered obfuscated: no literal address ever appears in the page source.
CONTACT_EMAIL=
# Full profile URL (rel="me" lets Mastodon verify it back).
CONTACT_MASTODON=
# Username or full URL.
CONTACT_GITHUB=
CONTACT_KOFI=
CONTACT_BUYMEACOFFEE=

# =============================================================================
# Legal / Impressum — the /imprint page appears once IMPRINT_NAME is set.
# Use \n inside address / extra to force line breaks.
# =============================================================================

IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
IMPRINT_PHONE=
IMPRINT_VAT=
IMPRINT_EXTRA=

# Optional data-residency note shown on /privacy. Blank hides the line.
DATA_LOCATION=
